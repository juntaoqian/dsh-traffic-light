{
  "name": "dsh-traffic-light",
  "version": "1.4.0",
  "description": "DeepSeek Harness Web UI 左下角红绿灯：汇总所有会话的运行/等待状态，红灯/黄灯蜂鸣提醒，设置页可配置（含 6 种音效），可选把状态上报到公网看板。",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.1-rc.2"
  },
  "author": "juntaoqian",
  "homepage": "https://github.com/juntaoqian/dsh-traffic-light#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/juntaoqian/dsh-traffic-light.git"
  },
  "bugs": {
    "url": "https://github.com/juntaoqian/dsh-traffic-light/issues"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "traffic-light",
    "status",
    "notification"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "proxy.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
